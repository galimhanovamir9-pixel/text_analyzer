# Запрашиваем у пользователя слово или фразу и сохраняем введённый текст в переменную text
text = input('Введите слово или фразу:')

# Убираем пробелы из текста и считаем количество оставшихся символов
length = len(text.replace(" ", ""))

# Выводим пользователю длину введённого текста
print(f'Длина слова: {length} букв')

# Переводим текст в нижний регистр и убираем из него пробелы
purified = text.lower().replace(" ", "")

# Проверяем, одинаково ли очищенное слово читается слева направо и справа налево
if purified == purified[::-1]:

    # Сообщаем, что введённый текст является палиндромом
    print('Это палиндром')

# Если условие выше оказалось ложным
else:

    # Сообщаем, что введённый текст не является палиндромом
    print('Это не палиндром')

# Создаём строку со всеми гласными буквами русского языка
vowels = "аеёиоуыэюя"

# Создаём переменную-счётчик и устанавливаем её начальное значение в 0
vowels_number = 0

# Перебираем каждый символ введённого пользователем текста
for char in text.lower():

    # Проверяем, является ли текущий символ гласной буквой
    if char in vowels:

        # Увеличиваем количество найденных гласных на 1
        vowels_number += 1

# Выводим пользователю количество найденных гласных букв
print(f'Количество гласных букв : {vowels_number}')
